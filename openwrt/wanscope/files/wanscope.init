#!/bin/sh /etc/rc.common
# wanscope: bandwidth monitor (per device, per uplink, per service)

START=95
STOP=10
USE_PROCD=1
PROG=/usr/bin/wanscope

start_service() {
	config_load wanscope
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# the daemon removes its nftables table on exit; make sure it is gone
	nft delete table inet wanscope 2>/dev/null
	return 0
}

service_triggers() {
	procd_add_reload_trigger wanscope
}

reload_service() {
	stop
	start
}
