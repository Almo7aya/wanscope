
config wanscope 'main'
	option enabled '1'
	# where history is kept (minute files for minute_days, hourly for
	# hour_days, daily forever); use a USB disk on routers with small flash
	option data_dir '/usr/share/wanscope'
	option interval '1'
	option live_seconds '3600'
	option minute_days '365'
	option hour_days '731'
	option memory_days '35'
	# read DNS answers and TLS/QUIC server names on the LAN to name traffic
	option sniff '1'
	option offline_timeout '180'
	# look for a new release on GitHub once a day; update_auto installs it at night
	option update_check '1'
	option update_auto '0'

config guest 'guest'
	# allow | limit | block: what devices that join later get until approved
	# (limits in kB/s, 1000 bytes per second)
	option policy 'allow'
	option down '0'
	option up '0'

config notify 'notify'
	# none | telegram | command
	option method 'none'
	option new_device '1'
	option quota '1'
	option wan_offline '0'
	list cap_percent '80'
	list cap_percent '100'
	option daily_report '0'
	option report_time '09:00'
	option burst_mb '0'
	option burst_minutes '10'
	option update '1'

# Data plans are added on the Uplinks page, e.g.:
# config plan 'plan_router_1'
#	option name 'Router 1'
#	option type 'prepaid'        # prepaid | monthly
#	option size_gb '60'
#	list iface 'wan1'
#	option start '1795200000'    # prepaid: when the bundle was bought
#	option cycle_day '1'         # monthly: renewal day
